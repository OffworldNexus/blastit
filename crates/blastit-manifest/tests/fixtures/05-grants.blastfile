# Every grant row of §13.1 in one view: transaction control, functions (with
# and without `pg_catalog.`), the three column operations in both spellings,
# `delete`, and a `query` in each of its two string forms.
postgres $DATABASE_URL

view catalog GET "/catalog", "/catalog/{id:int}" {
    postgres {
        transactions
        functions st_distance, pg_catalog.unaccent
        select products(id, name), categories
        insert orders(id, total)
        update products(price)
        delete archived_products
        query 'SELECT count(*) FROM products WHERE price > $?'
        query "SELECT 1 FROM products WHERE name = $1"
    }
}
