# One view, two endpoints, one sandbox: the view's `use` and its grant apply to
# both routes, and only the endpoint's own `body` differs (§10.3, §7.3).
postgres $DATABASE_URL

trait session {
    postgres {
        transactions
    }
}

view cart {
    use session
    GET "/cart"
    POST "/cart/items" {
        body json
    }
    postgres {
        select cart_items(id, product_id)
    }
}
