# The callable, the application's name and the preload list (§7.1 rows 2-4).
#
# `app` is the one label the model carries without interpreting it, and the
# preload list keeps its written order with duplicates dropped.
app "shop"

entrypoint python "shop.wsgi:application" {
    preload "shop.urls", "shop.signals", "shop.urls"
}

view about "/about" {
    body none
}
