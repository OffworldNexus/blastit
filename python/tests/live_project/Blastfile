# The Blastfile a real blastit serves this project with (D3c).
#
# It is deliberately half-written in the same way a real one is: the view that
# the test suite exercises is granted, and the view that exists only for
# production traffic is not — which is the case `blastit-manifest fold` and a
# live-server suite are both for. Nothing here lists Django's own
# `set_config('TimeZone', …)`: that goes in a trait every view uses, because
# under blastit every request opens its own connection (§6).
postgres $DATABASE_URL

# Django's own connection housekeeping, which runs on every view.
trait django {
    postgres {
        query "SELECT set_config('TimeZone', $1, false)"
    }
}

# Complete: the one statement this view sends is granted.
view live-ok GET "/live/" {
    use django
    postgres {
        query 'SELECT 1'
    }
}

# The other half of the point: this view is served, it sends something, and the
# Blastfile does not grant it. The denial is in the log, and the live-server
# fixture is what puts it in the report.
view live-denied GET "/live/denied/" {
    use django
}
