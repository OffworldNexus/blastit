# The Blastfile a real blastit serves the packaged project with (D3c).
#
# The same half-written shape as `live_project`'s: the view the suite exercises
# is granted, and Django's own connection housekeeping lives in a trait every
# view uses, because under blastit every request opens its own connection (§6).
postgres $DATABASE_URL

trait django {
    postgres {
        query "SELECT set_config('TimeZone', $1, false)"
    }
}

view packaged GET "/packaged/" {
    use django
    postgres {
        query 'SELECT 1'
    }
}
