# The rootless image from a wheel built beforehand — `e2e/rootless/Dockerfile`
# without the Rust build, for a job that has already run
# `scripts/build-wheel.sh` (the same split as `e2e/Dockerfile.prebuilt`).
#
# The wheel is universal (`py3-none`), so `PYTHON_VERSION` is a *choice*, read out
# of the environment by the driver (`e2e/prebuilt_wheel.py`) unless a developer
# wheel (`cp3NN`) names the interpreter it needs. Nothing below writes a Python
# version down: `_bin` — and the init copy that holds the capabilities — is
# resolved from the installed package's own path.
#
# Exactly one blastit wheel must be in `dist/`. The capability block is the same
# as in the other rootless Dockerfile; see that file for why the capability goes
# to a *dedicated copy* of the init binary `_bin/blastit` (never to the shared
# one, which every process of the service uid can run).
ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim-trixie
COPY e2e/demo/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN apt-get update && apt-get install -y --no-install-recommends libcap2-bin \
    && rm -rf /var/lib/apt/lists/*
# The whole directory, not a glob: a glob that matches nothing fails the build
# with `lstat /dist`, where the check below says which wheels there are.
COPY dist/ /tmp/dist/
RUN set -e; \
    wheels="$(ls /tmp/dist/*.whl 2>/dev/null || true)"; \
    count="$(printf '%s\n' "$wheels" | grep -c . || true)"; \
    if [ "$count" != 1 ]; then \
        echo "e2e/rootless/Dockerfile.prebuilt wants exactly one blastit wheel in dist/, found $count:" >&2; \
        printf '%s\n' "$wheels" >&2; \
        exit 1; \
    fi; \
    pip install --no-cache-dir "$wheels"; \
    rm -rf /tmp/dist
# The dedicated copy of the init binary, with the capabilities (B1). `_bin` is
# resolved from the installed package — never a site-packages literal, because the
# interpreter's version moves — and the console script is run once so `_bin/`'s
# execute bits are restored after `pip` normalised the wheel's modes. `chown`
# clears a file capability, so nothing re-owns the file after the `setcap`.
ARG BLASTIT_UID=10000
RUN useradd --uid "$BLASTIT_UID" --user-group --create-home --shell /usr/sbin/nologin blastit \
    && blastit --version >/dev/null \
    && lib="$(python3 -I -c 'import blastit, pathlib; print(pathlib.Path(blastit.__file__).parent / "_bin")')" \
    && cp "$lib/blastit" "$lib/blastit-init" \
    && chown "$BLASTIT_UID:$BLASTIT_UID" "$lib/blastit-init" \
    && chmod 0500 "$lib/blastit-init" \
    && setcap 'cap_chown,cap_dac_override,cap_fowner,cap_kill,cap_setgid,cap_setuid,cap_setpcap+ep' \
         "$lib/blastit-init" \
    && getcap "$lib/blastit-init" && getcap "$lib/blastit"
COPY e2e/demo /app
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    BLASTIT_APP=demo.wsgi:application \
    BLASTIT_PRELOAD=demo.urls,notes.views \
    BLASTIT_MANIFEST=/app/Blastfile \
    PORT=8080
EXPOSE 8080
# The *copy* holds the capabilities; the shared `_bin/blastit` stays
# capability-free (B1). Both are resolved from the installed package here rather
# than written down (the compose service, which overrides this, resolves them the
# same way).
CMD ["sh", "-c", "lib=$(python3 -I -c 'import blastit, pathlib; print(pathlib.Path(blastit.__file__).parent / \"_bin\")'); export BLASTIT_EXEC=\"$lib/blastit\"; exec \"$lib/blastit-init\""]
