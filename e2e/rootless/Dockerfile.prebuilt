# The rootless image from a wheel built beforehand — `e2e/rootless/Dockerfile`
# without the Rust build, for a CI job that has already run
# `scripts/build-wheel.sh` (the same split as `e2e/Dockerfile.prebuilt`).
#
# Exactly one cp313 wheel must be in `dist/`. The capability block is the same
# as in the other rootless Dockerfile; see that file for why the capability goes
# to a *dedicated copy* of the interpreter (never to the shared one, which every
# process of the service uid can run).
FROM python:3.13-slim-trixie
COPY e2e/demo/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
RUN apt-get update && apt-get install -y --no-install-recommends libcap2-bin \
    && rm -rf /var/lib/apt/lists/*
COPY dist/blastit-*-cp313-*.whl /tmp/dist/
RUN set -e; \
    wheels="$(ls /tmp/dist/*.whl)"; \
    count="$(printf '%s\n' "$wheels" | wc -l)"; \
    if [ "$count" != 1 ]; then \
        echo "e2e/rootless/Dockerfile.prebuilt wants exactly one cp313 wheel in dist/, found $count:" >&2; \
        printf '%s\n' "$wheels" >&2; \
        exit 1; \
    fi; \
    pip install --no-cache-dir "$wheels"; \
    rm -rf /tmp/dist
ARG BLASTIT_UID=10000
RUN useradd --uid "$BLASTIT_UID" --user-group --create-home --shell /usr/sbin/nologin blastit
RUN interpreter="$(readlink -f /usr/local/bin/python3.13)" \
    && cp "$interpreter" "${interpreter%/*}/python3.13-init" \
    && chown "$BLASTIT_UID:$BLASTIT_UID" "${interpreter%/*}/python3.13-init" \
    && chmod 0500 "${interpreter%/*}/python3.13-init" \
    && setcap 'cap_chown,cap_dac_override,cap_fowner,cap_kill,cap_setgid,cap_setuid,cap_setpcap+ep' \
         "${interpreter%/*}/python3.13-init" \
    && getcap "${interpreter%/*}/python3.13-init" && getcap "$interpreter" || true
COPY e2e/demo /app
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app \
    BLASTIT_APP=demo.wsgi:application \
    BLASTIT_PRELOAD=demo.urls,notes.views \
    BLASTIT_MANIFEST=/app/blastit.toml \
    PORT=8080
EXPOSE 8080
# The *copy* holds the capabilities; the shared interpreter stays
# capability-free (B1).
CMD ["/usr/local/bin/python3.13-init", "-m", "blastit"]
