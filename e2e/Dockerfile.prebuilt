# Same image as e2e/Dockerfile, with the wheel built beforehand on the host: the
# driver runs `scripts/build-wheel.sh` and hands the `dist/*.whl` it produced to
# this build.
#
# The wheel decides the interpreter. `blastit._blastit` is not abi3, so a cp314
# wheel installs into CPython 3.14 and nowhere else, and the base image has to be
# the interpreter the wheel was built for — `PYTHON_VERSION`, which the driver
# reads out of the wheel's file name (`e2e/prebuilt_wheel.py`). 3.13 is only the
# default for a build that names no wheel.
ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim-trixie
COPY e2e/demo/requirements.txt /app/requirements.txt
COPY e2e/sqlalchemy/requirements.txt /sqlalchemy/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt -r /sqlalchemy/requirements.txt
# The whole directory, not a glob: a glob that matches nothing fails the build
# with `lstat /dist`, where the check below says which wheels there are.
COPY dist/ /tmp/dist/
# Exactly one: two wheels in `dist/` (a release and a development version, or a
# stale wheel from another interpreter) would make pip pick a fight here rather
# than say what is wrong, and this image is meant to install *the* wheel the
# driver just built. What its tag is, is answered above; how many there are is
# this check's.
RUN set -e; \
    wheels="$(ls /tmp/dist/*.whl 2>/dev/null || true)"; \
    count="$(printf '%s\n' "$wheels" | grep -c . || true)"; \
    if [ "$count" != 1 ]; then \
        echo "e2e/Dockerfile.prebuilt wants exactly one blastit wheel in dist/, found $count:" >&2; \
        printf '%s\n' "$wheels" >&2; \
        echo "clean up dist/, or keep only the one this image should install" >&2; \
        exit 1; \
    fi; \
    pip install --no-cache-dir "$wheels"; \
    rm -rf /tmp/dist
COPY e2e/demo /app
# The second app of the end-to-end test (E2b): Flask + SQLAlchemy, served from
# this directory so its own manifest and its own grants are what run it.
COPY e2e/sqlalchemy /sqlalchemy
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    BLASTIT_APP=demo.wsgi:application \
    BLASTIT_PRELOAD=demo.urls,notes.views \
    BLASTIT_MANIFEST=/app/blastit.toml \
    PORT=8080
EXPOSE 8080
CMD ["blastit"]
