# Same image as e2e/Dockerfile, with the wheel built beforehand on the host: the
# CI job runs `scripts/build-wheel.sh` against the same Python 3.13 and hands the
# `dist/*.whl` it produced to this build.
FROM python:3.13-slim-trixie
COPY e2e/demo/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt
COPY dist/blastit-*-cp313-*.whl /tmp/dist/
# Exactly one: two wheels of the same distribution in `dist/` (a release and a
# development version, say) would make pip pick a fight here rather than say what
# is wrong, and this image is meant to install *the* wheel CI just built.
RUN set -e; \
    wheels="$(ls /tmp/dist/*.whl)"; \
    count="$(printf '%s\n' "$wheels" | wc -l)"; \
    if [ "$count" != 1 ]; then \
        echo "e2e/Dockerfile.prebuilt wants exactly one cp313 wheel in dist/, found $count:" >&2; \
        printf '%s\n' "$wheels" >&2; \
        echo "clean up dist/, or keep only the one this image should install" >&2; \
        exit 1; \
    fi; \
    pip install --no-cache-dir "$wheels"; \
    rm -rf /tmp/dist
COPY e2e/demo /app
WORKDIR /app
ENV PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app \
    BLASTIT_APP=demo.wsgi:application \
    BLASTIT_PRELOAD=demo.urls,notes.views \
    BLASTIT_MANIFEST=/app/blastit.toml \
    PORT=8080
EXPOSE 8080
CMD ["blastit"]
