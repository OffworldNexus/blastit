# The production fixture served by `e2e/run_prod.py`'s **rootless** leg
# (`BLASTIT_PRESET=compose-traefik`): the URL store the Compose page writes
# (`DATABASE_URL=postgresql://…@pgbouncer:5432/shop?sslmode=disable`), so the
# app is handed a libpq socket URL with no password and dials the pool through
# dbproxy.
app "prod"

entrypoint php "public/index.php"

postgres $DATABASE_URL

# The view every client-address, sandbox and fair-queuing row uses.
view front GET "/whoami", "/fast", "/slow" {
}

# The catalogue: three columns of `products`, and nothing else.
view catalog GET "/catalog/*" {
    postgres {
        select products(id, name, price)
    }
}

# A second view with its own grant: the same application, another policy.
view warehouse GET "/warehouse/*" {
    postgres {
        select orders(customer_id, total)
    }
}

view env GET "/env" {
}

view probe GET "/shell", "/egress" {
}
