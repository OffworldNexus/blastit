# The Blastfile of the venv smoke test's app (ARCHITECTURE.md §6, §8.2).
#
# One view, and one PostgreSQL store the view has a grant on: the grant is what
# makes stage 0 bind the view's private socket and `execve` the Python-free
# `blastit/_bin/blastit-dbproxy` the wheel ships (§4). The upstream is never
# contacted — nothing in this test connects to it — the URL only has to parse.
postgres $DATABASE_URL

view root GET "/" {
    postgres {
        query 'SELECT 1'
    }
}
