# The Blastfile of the demo app. Generated by e2e/grants.py from a harvest of
# the e2e scenario, then committed (ARCHITECTURE.md §6).
#
# The views the scenario posts a form to declare `body form`: a body on a view
# with no codec is a `413` (ADR-0006), so leaving it out fails the scenario at
# the login form rather than at the database.
#
# Every view attaches the `connection` trait itself: nothing attaches a trait to
# every view at once, and the `deny` view below must use none — its empty
# `postgres { }` is the assertion (an empty allowlist refuses every statement
# with SQLSTATE 42501).
postgres $DATABASE_URL

# Django's own connection housekeeping: the time zone on a new connection when
# the server's isn't UTC, and the health check after a request had an error.
trait connection {
    postgres {
        query "SELECT set_config('TimeZone', $1, false)"
        query 'SELECT 1'
    }
}

# Statements several views share: session and user lookups.
trait session {
    postgres {
        query 'SELECT "django_session"."session_key", "django_session"."session_data", "django_session"."expire_date" FROM "django_session" WHERE ("django_session"."expire_date" > $1 AND "django_session"."session_key" = $2) LIMIT 21'
        query 'SELECT "auth_user"."id", "auth_user"."password", "auth_user"."last_login", "auth_user"."is_superuser", "auth_user"."username", "auth_user"."first_name", "auth_user"."last_name", "auth_user"."email", "auth_user"."is_staff", "auth_user"."is_active", "auth_user"."date_joined" FROM "auth_user" WHERE "auth_user"."id" = $1 LIMIT 21'
    }
}

view login GET, POST "/login/" {
    use connection
    body form
    postgres {
        transactions
        query 'SELECT "auth_user"."id", "auth_user"."password", "auth_user"."last_login", "auth_user"."is_superuser", "auth_user"."username", "auth_user"."first_name", "auth_user"."last_name", "auth_user"."email", "auth_user"."is_staff", "auth_user"."is_active", "auth_user"."date_joined" FROM "auth_user" WHERE "auth_user"."username" = $1 LIMIT 21'
        query 'SELECT $1 AS "a" FROM "django_session" WHERE "django_session"."session_key" = $2 LIMIT 1'
        query 'INSERT INTO "django_session" ("session_key", "session_data", "expire_date") VALUES ($1, $2, $3)'
        query 'UPDATE "auth_user" SET "last_login" = $1 WHERE "auth_user"."id" = $2'
        query 'UPDATE "django_session" SET "session_data" = $1, "expire_date" = $2 WHERE "django_session"."session_key" = $3'
    }
}

view logout POST "/logout/" {
    use connection, session
    body form
    postgres {
        transactions
        query 'SELECT "django_session"."session_key", "django_session"."session_data", "django_session"."expire_date" FROM "django_session" WHERE "django_session"."session_key" = $1 LIMIT 21'
        query 'DELETE FROM "django_session" WHERE "django_session"."session_key" IN ($1)'
    }
}

view notes "/notes/", "/notes/{id:int}/delete/", "/notes/peek/", "/notes/sql/" {
    use connection, session
    body form
    postgres {
        transactions
        query 'INSERT INTO "notes_note" ("owner_id", "text") VALUES ($1, $2) RETURNING "notes_note"."id"'
        query 'SELECT "notes_note"."id", "notes_note"."owner_id", "notes_note"."text" FROM "notes_note" WHERE "notes_note"."owner_id" = $1 ORDER BY "notes_note"."id" ASC'
        query 'SELECT "notes_note"."id", "notes_note"."owner_id", "notes_note"."text" FROM "notes_note" WHERE ("notes_note"."id" = $1 AND "notes_note"."owner_id" = $2) LIMIT 21'
        query 'DELETE FROM "notes_note" WHERE "notes_note"."id" IN ($1)'
    }
}

view debug GET "/debug/env/", "/debug/request/", "/debug/caps/", "/debug/egress/" {
    use connection
}

view sql GET "/debug/sql/" {
    use connection
    postgres {
        query 'SELECT count(*) FROM notes_note'
    }
}

# The only view that may reach the network (§7.3), and it has no
# grants: the probe opens no database connection at all.
view egress GET "/egress/probe/" {
    use connection
    egress any
}

# The view whose grant is *explicitly* empty — no statement and no
# trait — so its listener exists and refuses everything (SQLSTATE 42501).
view deny GET "/deny/sql/" {
    postgres {
    }
}

view fallback regex '.*' {
    use connection
}
