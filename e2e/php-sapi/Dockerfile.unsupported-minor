# The 8.2-only host (`MB.3.65`): the refusal a user actually sees.
#
# Debian bookworm ships PHP 8.2 as its distro PHP, and 8.2 is not a minor this
# build supports. A `[route.php]` boot on such a host must stop with one
# sentence naming the supported set — not with `.dynsym` inspection and not with
# a story about a missing `php_version` symbol.
#
# It is **not** a `scripts/platform_matrix.py` leg: it builds no shim and proves
# a refusal, not an artifact. Run it by hand:
#
#   docker build -f e2e/php-sapi/Dockerfile.unsupported-minor -t blastit-php-82:local .
#   docker run --rm blastit-php-82:local
#
# `run-unsupported-minor.sh` is the witness: it asserts the exact sentence, and
# that the boot wrote no serving surface.
ARG BASE=debian:bookworm
FROM ${BASE}

ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/root/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LIBCLANG_PATH=/usr/lib/llvm-14/lib

# The distro's own 8.2 packages, and the toolchain `blastit` needs. No shim is
# built: the boot refuses before it looks for one.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        php8.2-dev libphp8.2-embed \
        gcc make pkg-config libc6-dev binutils ca-certificates curl bash tar xz-utils \
        clang libclang-dev; \
    rm -rf /var/lib/apt/lists/*

RUN if ! command -v cargo >/dev/null; then \
        curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
            | bash -s -- -y --profile minimal --default-toolchain stable; \
    fi \
    && cargo --version

WORKDIR /src
COPY e2e/php-sapi/fixtures /fixtures
COPY . /src

# `blastit` only: the suites are not part of this witness (they would take their
# "no usable pair on this host" branch, which is not the sentence under test).
RUN cargo build --locked -p blastit

CMD ["sh", "/src/e2e/php-sapi/run-unsupported-minor.sh"]
